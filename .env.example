# Configure variáveis no terminal; este arquivo não é carregado automaticamente.
# Padrão sem variáveis: demonstração por regras, sem chamadas externas.
# Hospedagem sintética atrás de proxy HTTPS: configure apenas a origem abaixo,
# remova ELO_PLANNER=watsonx e não envie credenciais IBM para o serviço público.
# ELO_PUBLIC_ORIGIN=https://seu-servico.onrender.com
# PORT=8000
ELO_PLANNER=watsonx
IBM_CLOUD_API_KEY=
WATSONX_PROJECT_ID=
# Use um modelo Granite disponível na conta IBM da equipe. Sem ID presumido.
WATSONX_MODEL_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
